# Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Calendly URL for booking consultations.
# Optional — defaults to https://calendly.com/nahuelsoria/30min.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/nahuelsoria/30min

# Contact form delivery (app/api/contact). If neither is set, the form falls back to mailto.
# Option A — Resend: set the API key (and optionally a verified From address).
RESEND_API_KEY=
CONTACT_FROM=Portfolio <onboarding@resend.dev>
# Option B — generic webhook (Formspree / Zapier / n8n):
CONTACT_WEBHOOK_URL=

# Canonical site URL (metadata, hreflang, sitemap, JSON-LD, OG).
# Optional — defaults to https://nahuelsoria.vercel.app. Set to the .com once purchased.
NEXT_PUBLIC_SITE_URL=https://nahuelsoria.vercel.app
